{
  "name": "browser-tts-benchmark",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Repeatable, local browser-only TTS benchmarks in Google Chrome",
  "repository": {
    "type": "git",
    "url": "https://github.com/ngelik/tts-bench.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "browser-tts-bench": "./bin/bench.mjs"
  },
  "scripts": {
    "bench": "node bin/bench.mjs",
    "assets": "node bin/bench.mjs assets",
    "validate": "node tools/validate.mjs",
    "report": "node tools/report.mjs",
    "compare": "node tools/compare.mjs",
    "submit": "node tools/submit.mjs",
    "test": "node --test",
    "reference": "node tools/reference.mjs",
    "audio": "node tools/audio.mjs",
    "listen": "node tools/listen.mjs",
    "listen:build": "node tools/build-listening-site.mjs",
    "dashboard:build": "node tools/build-listening-site.mjs",
    "dashboard:preview": "node tools/serve-dashboard.mjs",
    "dashboard:check": "node tools/check-dashboard.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.5.1",
    "onnxruntime-web": "1.31.1",
    "onnxruntime-web-pocket": "npm:onnxruntime-web@1.31.1",
    "phonemizer": "1.2.1",
    "phonon-tts": "0.6.0",
    "playwright-core": "1.65.0",
    "sanotts-web": "0.3.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
