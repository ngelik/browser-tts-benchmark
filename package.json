{
  "name": "browser-tts-benchmark",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Repeatable, local browser-only TTS benchmarks in Google Chrome",
  "repository": {
    "type": "git",
    "url": "https://github.com/ngelik/browser-tts-benchmark.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "browser-tts-bench": "./bin/bench.mjs"
  },
  "scripts": {
    "bench": "node bin/bench.mjs",
    "assets": "node bin/bench.mjs assets",
    "validate": "node tools/validate.mjs",
    "report": "node tools/report.mjs",
    "compare": "node tools/compare.mjs",
    "submit": "node tools/submit.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "onnxruntime-web": "1.23.2",
    "phonemizer": "1.2.1",
    "phonon-tts": "0.6.0",
    "playwright-core": "1.65.0"
  }
}
