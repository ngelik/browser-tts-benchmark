{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ngelik/browser-tts-benchmark/schemas/result.schema.json",
  "title": "Browser TTS benchmark result v1",
  "description": "Structural contract. tools/results.mjs additionally enforces cross-field consistency, publication eligibility, canonical fixture, private-path rejection and actual GPU dispatch requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "createdAt",
    "origin",
    "protocol",
    "environment",
    "fixture",
    "source",
    "assets",
    "cells"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "enum": [
        "native",
        "historical-import"
      ]
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scenario",
        "timingBoundary",
        "warmupRuns",
        "repetitions",
        "smoke",
        "networkMbps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scenario": {
          "enum": [
            "warm",
            "cold",
            "cached",
            "network",
            "offline",
            "switch"
          ]
        },
        "timingBoundary": {
          "type": "string",
          "minLength": 1
        },
        "warmupRuns": {
          "type": "integer",
          "minimum": 0
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "smoke": {
          "type": "boolean"
        },
        "networkMbps": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machineLabel",
        "os",
        "arch",
        "cpu",
        "logicalCores",
        "ramBytes",
        "chromeVersion",
        "gpu",
        "headless"
      ],
      "properties": {
        "machineLabel": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "logicalCores": {
          "type": "integer",
          "minimum": 1
        },
        "ramBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "chromeVersion": {
          "type": "string",
          "minLength": 1
        },
        "gpu": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "headless": {
          "type": "boolean"
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "characters",
        "chunks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "characters": {
          "type": "integer",
          "minimum": 1
        },
        "chunks": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gitCommit",
        "dirty",
        "manifestSha256"
      ],
      "properties": {
        "gitCommit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40,64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "dirty": {
          "type": "boolean"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256",
          "bytes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cell"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "generationMs",
        "samples",
        "sampleRate",
        "pcmSha256",
        "validation"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "generationMs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "samples": {
          "type": "integer",
          "minimum": 1
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        },
        "pcmSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "finitePcm",
            "chunkCount",
            "nonemptyChunks"
          ],
          "properties": {
            "finitePcm": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "chunkCount": {
              "type": "integer",
              "minimum": 1
            },
            "nonemptyChunks": {
              "const": true
            }
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "backendRequested",
        "backendEffective",
        "status",
        "reason",
        "voice",
        "precision",
        "settings",
        "capability",
        "warmup",
        "trials"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "backendRequested": {
          "enum": [
            "cpu",
            "webgpu",
            "webgl"
          ]
        },
        "backendEffective": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "measured",
            "unsupported",
            "error"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "voice": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "type": "string",
          "minLength": 1
        },
        "settings": {
          "type": "object"
        },
        "capability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gpuDispatchVerified",
            "description"
          ],
          "properties": {
            "gpuDispatchVerified": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "warmup": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trial"
          }
        },
        "trials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trial"
          }
        }
      }
    }
  }
}
